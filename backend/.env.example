# Gemini API key for the chat assistant.
# Create backend/.env from this file and put your real key there.
GEMINI_API_KEY=your_gemini_api_key_here

# Default chat model.
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# MCP server config for database sync.
MCP_URL=https://tool.vfmgroup.vn/db-mcp/mcp
MCP_TOKEN=your_mcp_token_here
